# Sending Gmail account
GMAIL_USER=konkolykitty@gmail.com
STUDIO_EMAIL=konkolykitty@gmail.com
INSTRUCTOR_EMAIL=konkolykitty@gmail.com

# --- Gmail OAuth 2.0 (recommended for Railway + local) ---
# 1) Google Cloud Console → create OAuth client (Web application)
# 2) Authorized redirect URI:
#    https://developers.google.com/oauthplayground
# 3) Enable Gmail API
# 4) OAuth 2.0 Playground → gear → use your own credentials
# 5) Authorize scope: https://mail.google.com/
# 6) Exchange authorization code for tokens → copy Refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Optional fallback (Resend) if OAuth is not set
# RESEND_API_KEY=
# EMAIL_FROM=Konga Kittivel <onboarding@resend.dev>
