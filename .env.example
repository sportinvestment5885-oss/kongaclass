# Where booking notifications are delivered (inbox you read)
INSTRUCTOR_EMAIL=konkolykitty@gmail.com

# --- Production on Railway: Resend + kongakittivel.hu ---
# 1) resend.com → Domains → Add kongakittivel.hu → copy DNS records
# 2) At your DNS host add the Resend SPF/DKIM records, wait until Verified
# 3) Railway env:
RESEND_API_KEY=
EMAIL_FROM=Konga Kittivel <info@kongakittivel.hu>

# Optional: create mailbox info@kongakittivel.hu and forward to konkolykitty@gmail.com
# so replies/mail to info@ arrive in Gmail. Sending still goes through Resend.

# Local fallback only (optional)
# GMAIL_USER=konkolykitty@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
